# Integracao XP - Data Access API. Nunca comite credenciais reais.
XP_INTEGRATION_ENABLED=false
XP_CHANNEL=data_access
XP_ENVIRONMENT=homologation          # homologation | production (outro valor nao e reconhecido)

# Tenant do AVREN OS que recebe os dados (uuid de auth.tenants)
XP_TENANT_ID=

# Endpoints (homologation: matls-api-hml.xpi.com.br | production: matls-api.xpi.com.br)
XP_API_BASE_URL=
XP_AUTH_URL=                         # DEVE ser https; sem isso o client_secret nao e enviado

# OAuth 2.0 client credentials via Azure AD
XP_AZURE_TENANT_ID=
XP_CLIENT_ID=
XP_CLIENT_SECRET=
# OBRIGATORIO desde a v3.1: client credentials no Azure AD exige scope
# explicito. Formato tipico do Azure: api://<application-id>/.default
# Confirmar o valor exato na documentacao credenciada da XP.
XP_OAUTH_SCOPE=api://<application-id-da-xp>/.default

# Subscription Key (APIM) - obrigatoria em todo request, alem do OAuth
XP_SUBSCRIPTION_KEY=

# User-Agent de parceiro. Formato RFC 7231 (produto/versao + comentario
# identificando o parceiro e o contato tecnico), que e o padrao pedido
# por gateways corporativos para rastrear consumo por integrador.
# CONFIRMAR a string exata com a XP no credenciamento: se houver um
# formato proprietario (ex.: codigo de parceiro), usar o deles.
XP_USER_AGENT=AVREN-OS/1.0 (parceiro=AVREN; contato=ti@aureninvest.com)

# mTLS - preencher UMA das duas opcoes (nunca as duas)
XP_MTLS_CERT_PATH=
XP_MTLS_KEY_PATH=
XP_MTLS_CERT_BASE64=
XP_MTLS_KEY_BASE64=
XP_MTLS_CERT_EXPIRES_AT=             # ISO 8601; alimenta o alerta de vencimento (30 dias)

# Rede: faixas validadas (fora da faixa = erro explicito, nao ajuste silencioso)
XP_HTTP_TIMEOUT_MS=15000             # 1000..120000
XP_HTTP_MAX_RETRIES=3                # 0..5
XP_RATE_LIMIT_RPS=5                  # 1..50
XP_PAGE_SIZE=200                     # 1..500

# Cron noturno (05:30 Brasilia). Exige TAMBEM a flag geral ligada.
XP_SYNC_CRON_ENABLED=false

# Testes de banco (CI): credenciais SEPARADAS
# TEST_ADMIN_DATABASE_URL=postgres://admin:...@host/db_test   (aplica migrations)
# TEST_DATABASE_URL=postgres://app:...@host/db_test           (sem BYPASSRLS)
# XP_DB_TESTS_REQUIRED=true                                   (falha se ausentes)
