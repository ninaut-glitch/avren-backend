# Integracao XP - Data Access API. Nunca comite credenciais reais.
XP_INTEGRATION_ENABLED=false
XP_CHANNEL=data_access
XP_ENVIRONMENT=homologation

# Endpoints (variam entre homologation e production - ver XP_INTEGRATION.md)
# homologation: matls-api-hml.xpi.com.br | production: matls-api.xpi.com.br
XP_API_BASE_URL=
XP_AUTH_URL=

# OAuth 2.0 client credentials via Azure AD
XP_AZURE_TENANT_ID=
XP_CLIENT_ID=
XP_CLIENT_SECRET=

# Subscription Key (APIM) - obrigatoria em todo request, alem do OAuth
XP_SUBSCRIPTION_KEY=

# mTLS - preencher UMA das duas opcoes (nunca as duas)
# Opcao 1: certificado montado como volume no servico (Easypanel)
XP_MTLS_CERT_PATH=
XP_MTLS_KEY_PATH=
# Opcao 2: certificado em Base64 (alternativa quando nao ha volume disponivel)
XP_MTLS_CERT_BASE64=
XP_MTLS_KEY_BASE64=

# Data de expiracao do certificado mTLS (ISO 8601) - usada para alertar
# a equipe antes do vencimento. Preencher ao instalar o certificado.
XP_MTLS_CERT_EXPIRES_AT=
